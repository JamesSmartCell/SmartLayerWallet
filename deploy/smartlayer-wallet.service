[Unit]
Description=SmartLayer Wallet - Next.js Backend
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/dev/SmartLayerWallet
EnvironmentFile=/home/pi/dev/SmartLayerWallet/.env
Environment=NODE_ENV=production
Environment=PORT=8089

# IMPORTANT: If using nvm, systemd cannot find node via /usr/bin/env node
# You MUST use the absolute path to the node binary:
# 1. Find your node path: which node  (e.g. /home/pi/.nvm/versions/node/v24.11.0/bin/node)
# 2. Replace ExecStart below with that absolute path
# Example for nvm node v24.11.0:
#   ExecStart=/home/pi/.nvm/versions/node/v24.11.0/bin/node /home/pi/dev/SmartLayerWallet/start-server.js

# WARNING: EnvironmentFile does NOT strip inline # comments
# Your .env must have NO inline comments like: SOME_VAR=value # comment
# Put comments on separate lines only

ExecStart=/usr/bin/env node /home/pi/dev/SmartLayerWallet/start-server.js

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=smartlayer-wallet

[Install]
WantedBy=multi-user.target
