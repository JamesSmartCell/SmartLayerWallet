# SmartLayerWallet Environment Configuration
# Copy this file to .env and fill in your actual values
# WARNING: systemd EnvironmentFile does NOT strip inline # comments - use separate lines only

# ===== SERVER-SIDE ONLY =====
# These are never exposed to the client bundle

# Coinbase CDP API Key (required for ERC-4337 bundler/paymaster)
# Server-side only - proxied via /api/bundler/[chainId]
# WARNING: NEVER put this in a NEXT_PUBLIC_ variable - it would be exposed to the browser
CDP_API_KEY=your_coinbase_api_key_here

# Server-side SQLite database path (for passkey storage)
WALLET_DB_PATH=./data/wallet.db

# Allowed origins for WebAuthn (comma-separated)
# Production: https://wallet.percolate.one
# Development: also include localhost:* automatically
WALLET_ALLOWED_ORIGINS=https://wallet.percolate.one

# Camera gate upstream (LAN address of Pi camera)
# Used by Next.js /cam-gate route to proxy camera requests
CAMERA_GATE_UPSTREAM=http://192.168.50.224:8787

# Optional: Custom RPC URL per chain (server-side reads via @smarttokenlabs/waterfall-rpc)
# CUSTOM_RPC_URL_84532=https://base-sepolia.g.alchemy.com/v2/your_key
# CUSTOM_RPC_URL_8453=https://base-mainnet.g.alchemy.com/v2/your_key
# CUSTOM_RPC_URL_1=https://eth-mainnet.g.alchemy.com/v2/your_key

# Optional: Custom CDP bundler URL per chain (overrides default Coinbase endpoints)
# CDP_BUNDLER_URL_84532=https://custom-bundler.example.com/base-sepolia
# CDP_BUNDLER_URL_8453=https://custom-bundler.example.com/base

# ===== CLIENT-SIDE (NEXT_PUBLIC_*) =====

# WebAuthn RP ID (auto-detected from hostname if not set)
# For localhost: localhost
# For production: percolate.one
NEXT_PUBLIC_RP_ID=

# Garage Door NFT Configuration
NEXT_PUBLIC_GARAGE_DOOR_NFT_ADDRESS=0x3158e836ec0e85A46f7a7208d91EA9837A0C6ccC
NEXT_PUBLIC_IOT_DEVICE_ADDRESS=0xb1a6929c36c0ad999806a96dfe718777e650f395
NEXT_PUBLIC_IOT_CAMERA_ADDRESS=0x38Ba3A68D4460Cf4747A0303D8e2C106cFF68F3f

# Garage door API (SmartLayerProxy)
NEXT_PUBLIC_GARAGE_API_BASE=https://scriptproxy.percolate.one/api

# Garage admin addresses (comma-separated, for admin UI features)
NEXT_PUBLIC_GARAGE_ADMIN_ADDRESSES=0xC067A53c91258ba513059919E03B81CF93f57Ac7,0x7e4b1da13c4a2a73fd05e928a6ed81b0a5d3007b

# Camera gate URL (proxied via Next.js /cam-gate route to LAN camera)
NEXT_PUBLIC_CAMERA_GATE_URL=/cam-gate

# Optional: Custom ERC-4337 contract addresses
# NEXT_PUBLIC_ENTRY_POINT=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789
# NEXT_PUBLIC_ACCOUNT_FACTORY=0x0BA5ED0c6AA8c49038F819E587E2633c4A9F428a

# ===== OPTIONAL: Standalone HTTPS Server (server-https.js) =====
# NOT used in production - only for standalone/dev deployments
# Production uses Caddy on Linode with SSH tunnel to Pi
# PORT=8089
# BACKEND_PORT=8088
# SSL_CERT=/path/to/cert.pem
# SSL_KEY=/path/to/key.pem
