# GarageDoorKey - wallet.percolate.one
# Passkey/WebAuthn - Auto-detected from hostname (percolate.one)
NEXT_PUBLIC_RP_ID=percolate.one

# Garage Door specific (set in .env)
NEXT_PUBLIC_GARAGE_DOOR_NFT_ADDRESS=0x3158e836ec0e85A46f7a7208d91EA9837A0C6ccC
NEXT_PUBLIC_IOT_DEVICE_ADDRESS=0xb1a6929c36c0ad999806a96dfe718777e650f395
NEXT_PUBLIC_GARAGE_API_BASE=https://proxy.percolate.one/api

# Coinbase CDP client key for RPC/OnchainKit
NEXT_PUBLIC_CDP_API_KEY=pk_...

# Bundler/Paymaster (Base Sepolia only)
NEXT_PUBLIC_PAYMASTER_AND_BUNDLER_BASE_SEPOLIA=https://api.developer.coinbase.com/rpc/v1/base-sepolia/YOUR_KEY
NEXT_PUBLIC_NODE_RPC_BASE_SEPOLIA=https://sepolia.base.org

# Passkey backend (for registration/auth) - use SmartLayerProxy at proxy.percolate.one
NEXT_PUBLIC_BACKEND_API_URL=https://proxy.percolate.one/api

# Recovery API - same proxy for cross-device passkey sync
NEXT_PUBLIC_RECOVERY_API_BASE=https://proxy.percolate.one
